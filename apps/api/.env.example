# ============================================================================
# Variables de entorno de la API de Qemzagram.
# NO subas el archivo .env a GitHub (ya está en .gitignore).
# Para generar el tuyo con secretos aleatorios, ejecutá en la raíz:  npm run setup
# ============================================================================

NODE_ENV=development
PORT=4000

# Base de datos. Con Docker:
DATABASE_URL=postgres://qemzagram:qemzagram_dev@localhost:5432/qemzagram
# Sin Docker (base embebida, solo para probar rápido; los datos se guardan en esa carpeta):
# DATABASE_URL=pglite://./.data/dev

# Dirección pública de la WEB (se usa para CORS, protección CSRF y enlaces de los correos).
WEB_ORIGIN=http://localhost:3000

# Secretos (mínimo 32 caracteres). Cada uno debe ser distinto y NUNCA compartirse.
JWT_ACCESS_SECRET=cambiar-por-un-valor-aleatorio-de-64-caracteres-hex
JWT_TICKET_SECRET=cambiar-por-otro-valor-aleatorio-de-64-caracteres-hex
# "Pimienta" de contraseñas: si la perdés, nadie podrá iniciar sesión. Guardala en un lugar seguro.
PASSWORD_PEPPER=cambiar-por-un-valor-aleatorio-largo
# Clave AES-256 (32 bytes en base64) con la que se cifran los mensajes en la base de datos.
# Si la perdés, los mensajes guardados NO se pueden recuperar.
MESSAGE_ENC_KEY=cambiar-por-32-bytes-en-base64

# Correo saliente. En desarrollo, Mailpit (docker) recibe todo en http://localhost:8025.
# Si SMTP_HOST queda vacío, los enlaces se imprimen en la consola de la API.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Qemzagram <no-reply@qemzagram.local>

# Carpeta de fotos de perfil/portada (en producción usar almacenamiento externo, ver docs).
UPLOAD_DIR=./uploads

# Adjuntos de los chats y stickers propios: se guardan CIFRADOS y fuera de la carpeta pública.
MEDIA_DIR=./media

# Antivirus ClamAV (servicio clamd). OBLIGATORIO en producción; en desarrollo, vacío = sin análisis.
CLAMAV_HOST=
CLAMAV_PORT=3310

# ffmpeg y ffprobe (notas de voz y videos). Si no están en el PATH, poné la ruta completa.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Aplicar migraciones de base de datos al iniciar.
RUN_MIGRATIONS=true
