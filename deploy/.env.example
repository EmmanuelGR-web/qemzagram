# ─────────────────────────────────────────────────────────────────────────────
# Configuración de PRODUCCIÓN (deploy/.env). NUNCA la subas al repositorio.
# Generala con secretos aleatorios (desde la raíz del repo, en el servidor):
#   docker run --rm -v "$PWD":/repo -w /repo node:24-bookworm-slim node scripts/setup-env.mjs --produccion
# Después completá a mano lo marcado con  ← COMPLETAR.
# ─────────────────────────────────────────────────────────────────────────────

# Dominio del sitio (sin https://). Con DuckDNS: tunombre.duckdns.org   ← COMPLETAR
# Las llamadas usan livekit.<DOMAIN> (DuckDNS lo resuelve solo).
DOMAIN=
# Correo para los avisos de Let's Encrypt (vencimiento de certificados).   ← COMPLETAR
ACME_EMAIL=

# Base de datos (solo accesible dentro de Docker).
POSTGRES_PASSWORD=

# Secretos de la API. ⚠ Guardá una copia de PASSWORD_PEPPER y MESSAGE_ENC_KEY FUERA del servidor:
# sin ellos no se pueden verificar contraseñas ni descifrar mensajes (los backups no sirven).
JWT_ACCESS_SECRET=
JWT_TICKET_SECRET=
PASSWORD_PEPPER=
MESSAGE_ENC_KEY=

# Correos (verificación de cuenta, recuperación). Opciones GRATIS:
#  - Brevo (300/día, sin tarjeta): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, usuario y clave SMTP de Brevo.
#  - Gmail con "contraseña de aplicación" (requiere 2FA en la cuenta): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
# Oracle bloquea el puerto 25: usá 587.   ← COMPLETAR
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Qemzagram <no-reply@example.com>

# Adjuntos cifrados en Backblaze B2 (10 GB gratis). Bucket PRIVADO + "Application Key" solo de ese bucket.   ← COMPLETAR
# Para dejarlos en el disco del servidor: STORAGE_DRIVER=local (y quedan en el volumen api-media).
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=media/
S3_FORCE_PATH_STYLE=true

# Llamadas (LiveKit propio en el mismo servidor). Generadas al azar.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Notificaciones push (Web Push). Generadas al azar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@example.com

# Backups diarios (docs/DESPLIEGUE.md §11). Bucket B2 DISTINTO del de los adjuntos, con su propia clave.   ← COMPLETAR
# BACKUP_AGE_RECIPIENT = clave PÚBLICA de age (age1…). La privada NO va en el servidor.
BACKUP_AGE_RECIPIENT=
BACKUP_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
BACKUP_S3_REGION=us-east-005
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# 0 = no borrar desde el servidor (la regla de ciclo de vida del bucket limpia los viejos).
BACKUP_KEEP_DAYS=0
# Hora del backup en UTC (6 = 3:00 en Argentina).
BACKUP_HOUR_UTC=6
# Opcional: URL de healthchecks.io (gratis): te avisa por correo si un día no hubo backup.
BACKUP_PING_URL=

# Anti-bots (obligatorio en producción).
POW_ENABLED=true
POW_DIFFICULTY=16
